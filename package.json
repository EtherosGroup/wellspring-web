{
    "name": "@etheros/wellspring-web",
    "version": "0.5.0",
    "description": "Wellspring 网页托管骨架：只保留网关连接与静态资源下发，网页由使用者自行编写",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EtherosGroup/wellspring-web.git"
    },
    "homepage": "https://github.com/EtherosGroup/wellspring-web#readme",
    "bugs": {
        "url": "https://github.com/EtherosGroup/wellspring-web/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "index.ts",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "index.ts",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node scripts/run-tests.mjs",
        "build:zip": "node scripts/build-zip.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@xyit/wellspring": "^1.7.6",
        "pino": "^10.4.0",
        "typescript": "^7.0.2"
    },
    "wellspring": {
        "apiVersion": 1,
        "name": "wellspring-web",
        "npm": "@etheros/wellspring-web",
        "github": "EtherosGroup/wellspring-web",
        "sandbox": {
            "profile": "plugin",
            "fs": {
                "read": [],
                "write": []
            },
            "hostApi": ["logger", "fs", "http", "event"]
        }
    }
}
