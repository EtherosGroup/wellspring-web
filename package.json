{
    "name": "@xyit-team/wellspring-web",
    "version": "0.1.0",
    "description": "Wellspring 网页界面插件：从插件数据目录的 www/ 下发静态资源，经 wellspring-gateway 统一入口访问",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xyit-team/wellspring-web.git"
    },
    "homepage": "https://github.com/xyit-team/wellspring-web#readme",
    "bugs": {
        "url": "https://github.com/xyit-team/wellspring-web/issues"
    },
    "type": "module",
    "main": "index.ts",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "index.ts",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node scripts/run-tests.mjs",
        "build:zip": "node scripts/build-zip.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@xyit/wellspring": "^1.7.6",
        "pino": "^10.4.0",
        "typescript": "^7.0.2"
    },
    "wellspring": {
        "apiVersion": 1,
        "name": "wellspring-web",
        "npm": "@xyit-team/wellspring-web",
        "github": "xyit-team/wellspring-web",
        "sandbox": {
            "profile": "plugin",
            "fs": {
                "read": [],
                "write": []
            },
            "hostApi": ["logger", "fs", "http", "event"]
        }
    }
}
