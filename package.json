{
    "name": "@etheros/wellspring-web",
    "version": "0.4.0",
    "description": "Wellspring 网页界面插件：在浏览器里与 Agent 对话（流式回复、会话续接、工具过程、提问与提权审批）",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EtherosGroup/wellspring-web.git"
    },
    "homepage": "https://github.com/EtherosGroup/wellspring-web#readme",
    "bugs": {
        "url": "https://github.com/EtherosGroup/wellspring-web/issues"
    },
    "type": "module",
    "main": "index.ts",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "index.ts",
        "src",
        "docs",
        "www",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node scripts/run-tests.mjs",
        "build:ui": "pnpm -C frontend run build",
        "build:zip": "node scripts/build-zip.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@xyit/wellspring": "^1.7.6",
        "pino": "^10.4.0",
        "typescript": "^7.0.2"
    },
    "wellspring": {
        "apiVersion": 1,
        "name": "wellspring-web",
        "npm": "@etheros/wellspring-web",
        "github": "EtherosGroup/wellspring-web",
        "sandbox": {
            "profile": "plugin",
            "fs": {
                "read": [],
                "write": []
            },
            "hostApi": [
                "logger",
                "fs",
                "http",
                "event",
                "agent",
                "models",
                "workspaces",
                "getHost"
            ]
        }
    },
    "publishConfig": {
        "access": "public"
    }
}
